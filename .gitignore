# TypeScript incremental build artifacts
*.tsbuildinfo

# This project standardizes on npm (package-lock.json). Other lockfiles are
# ignored so a stray `bun install` / `yarn install` can't reintroduce a second
# source of truth — Vercel picks its package manager by which lockfile it finds.
bun.lock
bun.lockb
pnpm-lock.yaml
yarn.lock

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Python build/test artifacts
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
build/

# Deploy secrets — single source of truth, NEVER commit (see scripts/deploy.env.example)
scripts/deploy.env
deploy.env
