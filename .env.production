# AI-agent v1.2 GA — client visibility flags (ai-agents.md §10 Q29(h)/Q31(i)).
#
# These mirror the server flags set in .github/workflows/supabase-functions.yml
# ("Set AI-agent GA flags"); the server enforces regardless of what the client
# renders, so these only control whether the mode switch, suggestion chips and
# file-workspace surfaces are drawn.
#
# WHERE THE HOSTING ENVIRONMENT READS THESE: the frontend host builds this
# repository with `vite build` (production mode), and Vite loads this file for
# every production build — so committing it IS the hosting-environment setting
# for our host. A host-dashboard environment variable of the same name would
# take precedence over this file if one is ever added.
VITE_CHAT_MODES_ENABLED=true
VITE_SUGGESTED_ACTIONS_ENABLED=true
VITE_FILE_WORKSPACE_ENABLED=true
