# Single source of truth for every deploy secret. Fill this ONCE.
#
#   1. cp scripts/deploy.env.example scripts/deploy.env
#   2. paste your real values below
#   3. scripts/preflight_check.sh    # live-tests every credential, fails loudly on a typo
#   4. scripts/setup_secrets.sh      # pushes them to Fly + GitHub + Supabase (idempotent)
#
# deploy.env is gitignored and must NEVER be committed. Re-run the scripts any time
# a value changes — they overwrite in place, so there is nothing to "reset".
#
# WHY these specific values: the worker (Python on Fly) talks to Redis over the native
# protocol; the sim-command edge function (Deno on Supabase) talks to the SAME Upstash
# database over HTTPS REST. One database, two access styles → hence two Upstash entries.

# ── Upstash (console.upstash.com → your database) ──────────────────────────────
# Native URL — "Redis" / ".env" / connect-snippet tab. Used by the Fly worker.
UPSTASH_REDIS_URL='rediss://default:<password>@<host>.upstash.io:6379'
# REST URL + token — "REST API" section. Used by the sim-command edge function.
UPSTASH_REDIS_REST_URL='https://<host>.upstash.io'
UPSTASH_REDIS_REST_TOKEN='<rest-token>'

# ── Supabase (dashboard → Project Settings → API) ──────────────────────────────
SUPABASE_URL='https://<ref>.supabase.co'
SUPABASE_SERVICE_ROLE_KEY='<service_role key — SECRET, never ships to the frontend>'
# Project ref = the <ref> subdomain above; used by the Supabase CLI.
SUPABASE_PROJECT_REF='<ref>'

# ── Fly (fly.io) ───────────────────────────────────────────────────────────────
FLY_APP_NAME='suresuite-sim-worker'
# From:  fly tokens create deploy -a suresuite-sim-worker
FLY_API_TOKEN='FlyV1 <token>'
